{
  "manifest_version": 3,
  "name": "Tung \u00b7 Chess.com Auto Next",
  "version": "1.0.0",
  "description": "Starts your next live Chess.com game after the result, using the time selected in Tung Tung Client.",
  "key": "",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.chess.com/*",
    "https://chess.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tung \u00b7 Auto Next Game",
    "default_popup": "options.html",
    "default_icon": "icon.png"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "engine.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
