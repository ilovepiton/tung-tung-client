--!nonstrict
local Runtime=require("../src/Runtime")
local Catalog=require("../src/Catalog")
local Policy=require("../src/Policy")
local Lease=require("../src/PropertyLease")
local Mock=require("./MockEngine")
local passed=0
local function test(name, fn)
    local ok, message=pcall(fn)
    if not ok then error("FAIL "..name..": "..tostring(message)) end
    passed+=1; print("PASS "..name)
end
local function new()
    local host=Mock.make(); local runtime=Runtime.new(host):start(); return runtime,host
end
local function command(runtime,host,id,enabled,value,target)
    host.advance(1)
    return runtime:dispatch({moduleId=id,enabled=enabled,value=value,targetUserId=target,requestId="test-"..id})
end
test("24 unique catalog IDs",function()
    assert(#Catalog.entries==24)
    local count=0;for id in Catalog.byId do count+=1;assert(#id<49) end;assert(count==24)
end)
test("malformed and unknown commands rejected",function()
    for _,raw in {false,"fly",{id="unknown"},{id="fly",enabled="yes"},{id="fly",enabled=true,value=0/0},{id="fly",enabled=true,value=math.huge},{id="spectate",enabled=true},{id="friend_fling"}} do
        assert(Policy.validate(raw,Catalog)==nil)
    end
end)
test("finite values clamped and arbitrary fields discarded",function()
    local c=Policy.validate({id="fly",enabled=true,value=1e8,arbitrary="payload"},Catalog)
    assert(c.value==300 and c.arbitrary==nil)
end)
test("server-side style request rate limiter has a bounded burst",function()
    local b={tokens=20,updated=0};for _=1,20 do assert(Policy.spend(b,0)) end
    assert(not Policy.spend(b,0));assert(Policy.spend(b,0.1))
end)
test("property leases restore original values",function()
    local l=Lease.new();local o={Speed=16};l:write(o,"Speed",32);l:write(o,"Speed",48);l:restoreAll();assert(o.Speed==16)
end)
test("property leases preserve changes made by the host game",function()
    local l=Lease.new();local o={Speed=16};l:write(o,"Speed",32);o.Speed=22;l:restoreAll();assert(o.Speed==22)
end)
test("runtime reports actual local host session and unknown server outcome",function()
    local r,h=new();local s=r:snapshot();assert(s.connected and s.characterReady and not s.serverConfirmed)
    assert(#s.modules==24 and #h.transport.packets>0);r:destroy()
end)
test("stock missing server adapter disables friend fling and respawn",function()
    local r,h=new()
    assert(not command(r,h,"friend_fling",nil,nil,43).ok)
    assert(not command(r,h,"respawn").ok)
    assert(#h.target.Character.root.impulses==0)
    for _,m in r:snapshot().modules do if m.id=="friend_fling" or m.id=="respawn" then assert(not m.available) end end
    r:destroy()
end)
test("walk speed readback and restoration",function()
    local r,h=new();local hum=h.player.Character.humanoid
    assert(command(r,h,"speed",true,40).ok and hum.WalkSpeed==40)
    assert(command(r,h,"speed",false).ok and hum.WalkSpeed==16);r:destroy()
end)
test("super jump supports both character jump modes",function()
    local r,h=new();local hum=h.player.Character.humanoid
    assert(command(r,h,"super_jump",true,4).ok and hum.JumpPower==100 and hum.JumpHeight==28.8)
    command(r,h,"super_jump",false);assert(hum.JumpPower==50 and hum.JumpHeight==7.2);r:destroy()
end)
test("noclip alters every character BasePart and restores it",function()
    local r,h=new();local c=h.player.Character
    assert(command(r,h,"noclip",true).ok and not c.root.CanCollide and not c.head.CanCollide)
    command(r,h,"noclip",false);assert(c.root.CanCollide and c.head.CanCollide);r:destroy()
end)
test("fly uses modern LinearVelocity and keyboard-driven velocity",function()
    local r,h=new();assert(command(r,h,"fly",true,60).ok)
    assert(r.flyVelocity.ClassName=="LinearVelocity" and r.flyVelocity.MaxForce>0)
    h.services.UserInputService.keys.W=true;r:_step(0.016);assert(r.flyVelocity.VectorVelocity.Magnitude==60)
    local velocity=r.flyVelocity;command(r,h,"fly",false);assert(velocity.Destroyed);r:destroy()
end)
test("text entry does not move flying avatar",function()
    local r,h=new();command(r,h,"fly",true);h.services.UserInputService.keys.W=true
    h.services.UserInputService.textBox={};r:_step(0.016);assert(r.flyVelocity.VectorVelocity.Magnitude==0);r:destroy()
end)
test("low gravity compensates local assembly mass without changing world gravity",function()
    local r,h=new();local gravity=h.services.Workspace.Gravity
    command(r,h,"low_gravity",true,0.5);assert(r.gravityForce.Force.Y==10*gravity*0.5)
    assert(h.services.Workspace.Gravity==gravity);local force=r.gravityForce
    command(r,h,"low_gravity",false);assert(force.Destroyed);r:destroy()
end)
test("freeze restores anchored state and rejects movement actions",function()
    local r,h=new();command(r,h,"freeze",true);assert(h.player.Character.root.Anchored)
    assert(not command(r,h,"dash").ok);command(r,h,"freeze",false);assert(not h.player.Character.root.Anchored);r:destroy()
end)
test("dash and self fling use bounded impulses with cooldown",function()
    local r,h=new();local root=h.player.Character.root
    assert(command(r,h,"dash").ok);assert(root.impulses[1].Magnitude<1000)
    assert(not r:dispatch({id="dash"}).ok);assert(command(r,h,"self_fling").ok)
    assert(root.impulses[2].Magnitude<1000);r:destroy()
end)
test("slide requires ground and a free character",function()
    local r,h=new();local hum=h.player.Character.humanoid
    hum.FloorMaterial="Air";assert(not command(r,h,"slide").ok)
    hum.FloorMaterial="Concrete";assert(command(r,h,"slide").ok);r:destroy()
end)
test("return spawn resets self velocities and returns saved pivot",function()
    local r,h=new();local c=h.player.Character;local spawn=c.root.CFrame
    c.root.CFrame=Mock.CFrame.new(100,8,0);assert(command(r,h,"return_spawn").ok)
    assert(c.root.CFrame==spawn and c.root.AssemblyLinearVelocity.Magnitude==0);r:destroy()
end)
test("double jump permits one extra jump then resets on landing",function()
    local r,h=new();command(r,h,"double_jump",true);local c=h.player.Character;c.humanoid.FloorMaterial="Air"
    r:_jump();assert(#c.root.impulses==1);h.advance(0.3);r:_jump();assert(#c.root.impulses==1)
    c.humanoid.FloorMaterial="Concrete";r:_step(0.016);c.humanoid.FloorMaterial="Air";r:_jump();assert(#c.root.impulses==2);r:destroy()
end)
test("air jump repeats with cooldown and respects typing",function()
    local r,h=new();command(r,h,"air_jump",true);local c=h.player.Character;c.humanoid.FloorMaterial="Air"
    r:_jump();r:_jump();assert(#c.root.impulses==1);h.advance(0.3);r:_jump();assert(#c.root.impulses==2)
    h.services.UserInputService.textBox={};h.advance(0.3);r:_jump();assert(#c.root.impulses==2);r:destroy()
end)
test("spin creates a removable AngularVelocity and restores AutoRotate",function()
    local r,h=new();command(r,h,"spin",true,4);assert(not h.player.Character.humanoid.AutoRotate)
    local spin=r.objects.spin[2];assert(spin.ClassName=="AngularVelocity" and spin.AngularVelocity.Y==4)
    command(r,h,"spin",false);assert(spin.Destroyed and h.player.Character.humanoid.AutoRotate);r:destroy()
end)
test("avatar trails own only new attachments and the new trail",function()
    local r,h=new();command(r,h,"trails",true);local owned=table.clone(r.objects.trails);assert(#owned==3 and owned[3].ClassName=="Trail")
    command(r,h,"trails",false);for _,o in owned do assert(o.Destroyed) end;r:destroy()
end)
test("spectate restores original subject",function()
    local r,h=new();local camera=h.services.Workspace.CurrentCamera;local subject=camera.CameraSubject
    assert(command(r,h,"spectate",true,nil,43).ok and camera.CameraSubject==h.target.Character.humanoid)
    command(r,h,"spectate",false);assert(camera.CameraSubject==subject);r:destroy()
end)
test("freecam isolates keyboard control and restores mouse and camera",function()
    local r,h=new();local cam=h.services.Workspace.CurrentCamera;local frame=cam.CFrame
    command(r,h,"freecam",true,30);assert(cam.CameraType=="Scriptable" and h.services.ContextActionService.bindings.TungTungFreecam)
    h.services.UserInputService.keys.W=true;h.services.UserInputService.mouse=true;r:_step(0.1)
    assert(cam.CFrame.Position.Z<frame.Position.Z and h.services.UserInputService.MouseBehavior=="LockCurrentPosition")
    command(r,h,"freecam",false);assert(cam.CFrame==frame and cam.CameraType=="Custom")
    assert(h.services.UserInputService.MouseBehavior=="Default" and h.services.ContextActionService.bindings.TungTungFreecam==nil);r:destroy()
end)
test("spectate/freecam mutual exclusion preserves independent FOV",function()
    local r,h=new();local cam=h.services.Workspace.CurrentCamera
    command(r,h,"fov",true,100);command(r,h,"freecam",true);command(r,h,"spectate",true,nil,43)
    assert(not r.active.freecam and r.active.spectate and cam.FieldOfView==100)
    command(r,h,"spectate",false);assert(cam.FieldOfView==100);command(r,h,"fov",false);assert(cam.FieldOfView==70);r:destroy()
end)
test("fullbright and sunset are local, reversible property leases",function()
    local r,h=new();local light=h.services.Lighting;local ambient=light.Ambient
    command(r,h,"fullbright",true);command(r,h,"sunset",true);assert(light.Brightness==2.5 and light.ClockTime==17.6)
    command(r,h,"fullbright",false);command(r,h,"sunset",false);assert(light.Brightness==1 and light.ClockTime==12 and light.Ambient==ambient);r:destroy()
end)
test("post effects remove only their own instances",function()
    local r,h=new()
    for _,id in {"bloom","depth_of_field","color_grade"} do
        command(r,h,id,true);local effect=r.objects[id][1];assert(effect.Enabled and not effect.Destroyed)
        command(r,h,id,false);assert(effect.Destroyed)
    end;r:destroy()
end)
test("desktop settings validate atomically and update active effects",function()
    local r,h=new();command(r,h,"speed",true);command(r,h,"color_grade",true)
    assert(r:configure({walkSpeed=70,flySpeed=200,freecamSpeed=50,fov=105,shaderPreset="vibrant"}).ok)
    assert(h.player.Character.humanoid.WalkSpeed==70 and r.values.fly==200 and r.shaderPreset=="vibrant")
    assert(r.objects.color_grade[1].Saturation==0.3)
    assert(not r:configure({walkSpeed=40,shaderPreset="bad"}).ok and r.values.speed==70);r:destroy()
end)
test("local correction is reported rather than advertised as server confirmation",function()
    local r,h=new();command(r,h,"speed",true,40);h.player.Character.humanoid.WalkSpeed=16;r:_step(0.016)
    assert(string.find(r.status.speed,"corrected") and not r:snapshot().serverConfirmed);r:destroy()
end)
test("desktop command names and action ACK state match the loopback contract",function()
    local r,h=new()
    local result=r:dispatch({command="setModule",moduleId="dash",enabled=true,requestId="action-1"})
    assert(result.ok and result.enabled==false and result.requestId=="action-1")
    h.advance(1)
    assert(r:dispatch({command="playerAction",action="spectate",targetUserId=43}).ok)
    local a,b=r:snapshot(),r:snapshot();assert(b.revision>a.revision and #b.players==2 and b.players[2].name=="Friend")
    r:destroy()
end)
test("server-only actions require a confirmed receipt and explicit target consent",function()
    local r,h=new();local requests=0
    r.serverAdapter={
        getConsent=function(_,id) return {serverConfirmed=true,targetUserId=id,consented=true} end,
        request=function(_,request) requests+=1;return {serverConfirmed=false} end,
    }
    assert(not command(r,h,"friend_fling",nil,nil,43).ok)
    r.serverAdapter.request=function() return {serverConfirmed=true,targetConsented=false} end
    assert(not command(r,h,"friend_fling",nil,nil,43).ok)
    r.serverAdapter.request=function() return {serverConfirmed=true,targetConsented=true} end
    local result=command(r,h,"friend_fling",nil,nil,43)
    assert(result.ok and result.serverConfirmed and not result.appliedLocally and not result.enabled)
    assert(requests==1 and #h.target.Character.root.impulses==0);r:destroy()
end)
test("flingAllowed requires matching trusted server consent and does not call the action on denial",function()
    local r,h=new();local called=0
    r.serverAdapter={request=function() called+=1;return {serverConfirmed=true,targetConsented=true} end}
    assert(not command(r,h,"friend_fling",nil,nil,43).ok and called==0)
    r.serverAdapter.getConsent=function() return {serverConfirmed=true,targetUserId=42,consented=true} end
    assert(not r:snapshot().players[2].flingAllowed)
    assert(not command(r,h,"friend_fling",nil,nil,43).ok and called==0)
    r.serverAdapter.getConsent=function(_,id) return {serverConfirmed=true,targetUserId=id,consented=true} end
    assert(r:snapshot().players[2].flingAllowed)
    r.serverAdapter.getConsent=function() return {serverConfirmed=false,targetUserId=43,consented=true} end
    assert(not r:snapshot().players[2].flingAllowed);r:destroy()
end)
test("camera overlap and a stale inactive disable preserve the active mode",function()
    local r,h=new();local cam=h.services.Workspace.CurrentCamera
    command(r,h,"fov",true,105);command(r,h,"freecam",true);command(r,h,"spectate",true,nil,43)
    command(r,h,"freecam",false)
    assert(cam.CameraSubject==h.target.Character.humanoid and r.active.spectate and cam.FieldOfView==105)
    command(r,h,"spectate",false);assert(cam.CameraSubject==h.player.Character.humanoid and cam.FieldOfView==105)
    r:destroy();assert(cam.FieldOfView==70)
end)
test("camera replacement restores the old camera and adopts the new one",function()
    local r,h=new();local original=h.services.Workspace.CurrentCamera
    command(r,h,"fov",true,100);command(r,h,"freecam",true)
    local nextCamera={CFrame=Mock.CFrame.new(30,8,30),Focus=Mock.CFrame.new(30,8,0),FieldOfView=75,CameraType="Custom",CameraSubject=h.player.Character.humanoid}
    h.services.Workspace.CurrentCamera=nextCamera;r:_step(0.016)
    assert(original.CameraType=="Custom" and original.FieldOfView==70)
    assert(nextCamera.CameraType=="Scriptable" and nextCamera.FieldOfView==100)
    r:destroy();assert(nextCamera.CameraType=="Custom" and nextCamera.FieldOfView==75)
end)
test("fly freeze noclip overlap restores every independent property after respawn",function()
    local r,h=new();local c=h.player.Character
    command(r,h,"fly",true);command(r,h,"freeze",true);command(r,h,"noclip",true)
    h.services.UserInputService.keys.W=true;r:_step(0.016)
    assert(r.flyVelocity.VectorVelocity.Magnitude==0 and c.root.Anchored and not c.root.CanCollide)
    command(r,h,"freeze",false);r:_step(0.016);assert(r.flyVelocity.VectorVelocity.Magnitude>0 and not c.root.Anchored)
    command(r,h,"freeze",true);h.player.CharacterRemoving:Fire(c)
    assert(not c.root.Anchored and c.root.CanCollide and not r.active.fly and not r.active.noclip and not r.active.freeze)
    local nextCharacter=Mock.makeCharacter();h.player.Character=nextCharacter;h.player.CharacterAdded:Fire(nextCharacter)
    assert(not nextCharacter.root.Anchored and nextCharacter.root.CanCollide);r:destroy()
end)
test("respawn and death clear all character modifications",function()
    local r,h=new();command(r,h,"fly",true);command(r,h,"speed",true,40);command(r,h,"noclip",true)
    local old=h.player.Character;local velocity=r.flyVelocity;old.humanoid.Health=0;old.humanoid.Died:Fire()
    assert(not r.active.fly and velocity.Destroyed and old.humanoid.WalkSpeed==16 and old.root.CanCollide)
    h.player.CharacterRemoving:Fire(old);local fresh=Mock.makeCharacter();h.player.Character=fresh;h.player.CharacterAdded:Fire(fresh)
    assert(r:snapshot().characterReady and not r.active.speed);r:destroy()
end)
test("stop restores owned state, unsubscribes transport, disconnects every signal",function()
    local r,h=new();command(r,h,"speed",true,40);command(r,h,"fullbright",true);command(r,h,"freecam",true);command(r,h,"bloom",true)
    local bloom=r.objects.bloom[1];local connections=table.clone(r.connections);r:destroy();r:destroy()
    assert(h.transport.unsubscribed and not r:snapshot().connected and h.services.Lighting.Brightness==1)
    assert(h.player.Character.humanoid.WalkSpeed==16 and bloom.Destroyed)
    for _,c in connections do assert(not c.Connected) end
    for _,m in r:snapshot().modules do assert(not m.enabled) end
    assert(not r:dispatch({id="fly",enabled=true}).ok)
end)
